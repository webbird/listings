{#
    listings/twig/view_form.twig – an owner adds (mode new) or edits (mode edit) an entry.
    Editing is allowed by a mailed link (token) or, with an account, by item_key.
#}
{% set is_new = mode == 'new' %}
{% set auth %}
    {% if token|default('') != '' %}<input type="hidden" name="token" value="{{ token }}">{% else %}<input type="hidden" name="lst_item" value="{{ item_key|default('') }}">{% endif %}
{% endset %}
<div class="mod_listings lst-owner" id="lst-{{ section_id }}">
    <h2>{{ is_new ? t('NEW_ENTRY') : t('EDIT_ITEM', item.title) }}</h2>
    {% include '_messages.twig' %}
    {% if is_new %}
        <p class="lst-intro">{{ t(account ? (approval ? 'INTRO_NEW_ACCOUNT_APPROVAL' : 'INTRO_NEW_ACCOUNT') : (approval ? 'INTRO_NEW_APPROVAL' : 'INTRO_NEW')) }}</p>
    {% else %}
        <p class="lst-intro">{{ t('INTRO_STATUS_' ~ item.status|upper) }}
            {% if item.expires_at > 0 %}{{ t(expired ? 'EXPIRED_ON' : 'EXPIRES_ON', item.expires_at|date('d.m.Y')) }}{% endif %}</p>
        {% if extendable %}
        <form method="post" action="{{ action }}" class="lst-extend">
            <input type="hidden" name="section_id" value="{{ section_id }}">
            {{ FTAN|raw }}
            <input type="hidden" name="lst_action" value="extend">
            {{ auth }}
            <button type="submit">{{ t('EXTEND') }}</button>
        </form>
        {% endif %}
    {% endif %}

    <form method="post" action="{{ action }}" class="lst-owner-form">
        <input type="hidden" name="section_id" value="{{ section_id }}">
        {{ FTAN|raw }}
        <input type="hidden" name="lst_action" value="{{ is_new ? 'create' : 'update' }}">
        {% if not is_new %}{{ auth }}{% endif %}

        <div class="lst-row">
            <label for="lst_title_{{ section_id }}">{{ t('TITLE') }} *</label>
            <input type="text" id="lst_title_{{ section_id }}" name="title" maxlength="255" required value="{{ values.title|default('') }}">
        </div>

        {% if is_new and not account %}
        <div class="lst-row">
            <label for="lst_email_{{ section_id }}">{{ t('OWNER_EMAIL') }} *</label>
            <input type="email" id="lst_email_{{ section_id }}" name="owner_email" maxlength="255" required autocomplete="email" aria-describedby="lst_email_help_{{ section_id }}" value="{{ values.owner_email|default('') }}">
            <p class="lst-help" id="lst_email_help_{{ section_id }}">{{ t('HELP_OWNER_EMAIL') }}</p>
        </div>
        {% endif %}

        {% for f in fields %}
            {% if f.type == 'heading' %}
                {% include '_field.twig' with {f: f, v: null} only %}
            {% else %}
            <div class="lst-row">
                <label for="lst_f_{{ f.name }}">
                    {{ f.label }}{{ f.required ? ' *' }}
                    {% if f.visibility == 'owner' %}<span class="lst-badge">{{ t('NOT_PUBLIC') }}</span>{% endif %}
                </label>
                {% include '_field.twig' with {f: f, v: values.fields[f.name]|default(null)} only %}
                {% if f.help != '' %}<p class="lst-help">{{ f.help }}</p>{% endif %}
            </div>
            {% endif %}
        {% endfor %}

        {% if categories is not empty %}
        <fieldset class="lst-row lst-cat-choices">
            <legend>{{ t('CATEGORIES') }}</legend>
            {% for c in categories %}
                <label class="lst-level-{{ min(c.level, 4) }}"><input type="checkbox" name="categories[]" value="{{ c.cat_id }}"
                    {%- if c.cat_id in values.categories|default([]) or (c.cat_id ~ '') in values.categories|default([]) %} checked{% endif %}> {{ c.name }}</label>
            {% endfor %}
        </fieldset>
        {% endif %}
        {% if tags_mode == 'open' %}
        <div class="lst-row">
            <label for="lst_tags_{{ section_id }}">{{ t('TAGS') }}</label>
            <input type="text" id="lst_tags_{{ section_id }}" name="tags" maxlength="1000" value="{{ values.tags|default('') }}" aria-describedby="lst_tags_help_{{ section_id }}">
            <p class="lst-help" id="lst_tags_help_{{ section_id }}">{{ t('HELP_TAGS') }}</p>
        </div>
        {% elseif tags_mode == 'fixed' and all_tags is not empty %}
        <fieldset class="lst-row lst-tag-choices">
            <legend>{{ t('TAGS') }}</legend>
            {% for tag in all_tags %}
                <label><input type="checkbox" name="tag_ids[]" value="{{ tag.tag_id }}"
                    {%- if tag.tag_id in values.tag_ids|default([]) or (tag.tag_id ~ '') in values.tag_ids|default([]) %} checked{% endif %}> {{ tag.name }}</label>
            {% endfor %}
        </fieldset>
        {% endif %}

        {% if is_new %}
            {# the honeypot: out of sight for people, still filled in by bots #}
            <div class="lst-hp" aria-hidden="true">
                <label for="lst_hp_{{ section_id }}">Website</label>
                <input type="text" id="lst_hp_{{ section_id }}" name="lst_hp" value="" tabindex="-1" autocomplete="off">
            </div>
            <div class="lst-row lst-privacy">
                <label><input type="checkbox" name="privacy" value="1" required{% if values.privacy|default('') == '1' %} checked{% endif %}> {{ t('PRIVACY_CONSENT') }}</label>
            </div>
            {% if captcha %}<div class="lst-captcha">{{ captcha|raw }}</div>{% endif %}
        {% endif %}

        <div class="lst-buttons">
            <button type="submit">{{ is_new ? t('SUBMIT_NEW') : L_('TEXT:SAVE') }}</button>
            {% if account %}<a href="{{ link_url }}">{{ t('MY_ENTRIES') }}</a>{% endif %}
            <a href="{{ list_url }}">{{ t('BACK_TO_LIST') }}</a>
        </div>
    </form>

    {% if not is_new %}
    <form method="post" action="{{ action }}" class="lst-delete" data-lst-confirm="{{ t('CONFIRM_DELETE_ITEM', item.title) }}">
        <input type="hidden" name="section_id" value="{{ section_id }}">
        {{ FTAN|raw }}
        <input type="hidden" name="lst_action" value="delete">
        {{ auth }}
        <button type="submit">{{ t('DELETE_ENTRY') }}</button>
    </form>
    {% endif %}
</div>
