{#
    listings/twig/modify_field.twig – add or edit a field; backend_body.js shows the options of the chosen type
#}
{% extends 'modify.twig' %}
{% block content %}
{# the types that store a value; a heading has no options #}
{% set storing = 'text textarea number email url phone date datetime select radio checkboxes boolean image gallery file' %}
<h3>{{ field is null ? t('NEW_FIELD') : t('EDIT_FIELD', field.label) }}</h3>
<form method="post" action="{{ action }}" class="lst-form lst-field-form">
    {% include '_hidden.twig' %}
    <input type="hidden" name="lst_action" value="field_save">
    {% if field is not null %}<input type="hidden" name="lst_field" value="{{ idkey('field', field.field_id) }}">{% endif %}

    <div class="lst-row">
        <label for="lst_label">{{ t('FIELD_LABEL') }} *</label>
        <div><input type="text" id="lst_label" name="label" maxlength="255" required value="{{ form.label }}"></div>
    </div>
    <div class="lst-row">
        <label for="lst_name">{{ t('FIELD_NAME') }}</label>
        <div>
            {% if name_locked %}
                <code>{{ field.name }}</code>
                <p class="lst-help">{{ t('HELP_NAME_LOCKED') }}</p>
            {% else %}
                <input type="text" id="lst_name" name="name" maxlength="40" pattern="[a-z][a-z0-9_]*" value="{{ form.name }}">
                <p class="lst-help">{{ t('HELP_NAME') }}</p>
            {% endif %}
        </div>
    </div>
    <div class="lst-row">
        <label for="lst_type">{{ t('FIELD_TYPE') }}</label>
        <div>
            <select id="lst_type" name="type" data-lst-type>
                {% for type in types %}<option value="{{ type }}"{% if form.type == type %} selected{% endif %}>{{ t('TYPE_' ~ type|upper) }}</option>{% endfor %}
            </select>
        </div>
    </div>

    <div class="lst-row" data-lst-for="select radio checkboxes">
        <label for="lst_choices">{{ t('FIELD_CHOICES') }}</label>
        <div>
            <textarea id="lst_choices" name="choices" rows="6">{{ form.choices }}</textarea>
            <p class="lst-help">{{ t('HELP_CHOICES') }}</p>
        </div>
    </div>
    <div class="lst-row" data-lst-for="text textarea html">
        <label for="lst_maxlength">{{ t('FIELD_MAXLENGTH') }}</label>
        <div><input type="number" id="lst_maxlength" name="maxlength" min="1" max="65535" value="{{ form.maxlength }}"></div>
    </div>
    <div class="lst-row" data-lst-for="number">
        <label for="lst_min">{{ t('FIELD_RANGE') }}</label>
        <div>
            <input type="text" id="lst_min" name="min" size="8" value="{{ form.min }}" placeholder="min"> –
            <input type="text" name="max" size="8" value="{{ form.max }}" placeholder="max" aria-label="max">
        </div>
    </div>
    {% if not images_available %}
    <p class="lst-message lst-error" data-lst-for="image gallery">{{ t('ERR_NO_GD') }}</p>
    {% endif %}
    <div class="lst-row" data-lst-for="gallery file">
        <label for="lst_max_files">{{ t('FIELD_MAX_FILES') }}</label>
        <div><input type="number" id="lst_max_files" name="max_files" min="1" max="{{ max_files_limit }}" value="{{ form.max_files }}" placeholder="{{ form.type == 'file' ? default_max_files.file : default_max_files.gallery }}"></div>
    </div>
    <div class="lst-row" data-lst-for="image gallery file">
        <label for="lst_max_mb">{{ t('FIELD_MAX_MB') }}</label>
        <div>
            <input type="number" id="lst_max_mb" name="max_mb" min="0.1" step="0.1" value="{{ form.max_mb }}" placeholder="{{ form.type == 'file' ? default_max_mb.file : default_max_mb.image }}">
            <p class="lst-help">{{ t('HELP_MAX_MB', upload_limit) }}</p>
        </div>
    </div>
    <div class="lst-row" data-lst-for="image gallery">
        <label for="lst_max_px">{{ t('FIELD_MAX_PX') }}</label>
        <div>
            <input type="number" id="lst_max_px" name="max_px" min="100" max="{{ max_px_limit }}" value="{{ form.max_px }}" placeholder="{{ default_max_px }}">
            <p class="lst-help">{{ t('HELP_MAX_PX') }}</p>
        </div>
    </div>
    <div class="lst-row" data-lst-for="file">
        <label for="lst_extensions">{{ t('FIELD_EXTENSIONS') }}</label>
        <div>
            <input type="text" id="lst_extensions" name="extensions" maxlength="255" value="{{ form.extensions }}" placeholder="{{ default_extensions }}">
            <p class="lst-help">{{ t('HELP_EXTENSIONS') }}</p>
        </div>
    </div>

    <div class="lst-row">
        <label for="lst_help">{{ t('FIELD_HELP') }}</label>
        <div><input type="text" id="lst_help" name="help" maxlength="255" value="{{ form.help }}"></div>
    </div>
    <div class="lst-row" data-lst-for="{{ storing }}">
        <span class="lst-label">{{ t('FIELD_OPTIONS') }}</span>
        <div>
            <label><input type="checkbox" name="required" value="1"{% if form.required == '1' %} checked{% endif %}> {{ t('FIELD_REQUIRED') }}</label><br>
            <label><input type="checkbox" name="in_list" value="1"{% if form.in_list == '1' %} checked{% endif %}> {{ t('FIELD_IN_LIST') }}</label><br>
            <label><input type="checkbox" name="editable" value="1"{% if form.editable == '1' %} checked{% endif %}> {{ t('FIELD_EDITABLE') }}</label>
            <p class="lst-help">{{ t('HELP_EDITABLE') }}</p>
            <span data-lst-for="select radio checkboxes">
                <label><input type="checkbox" name="filterable" value="1"{% if form.filterable|default('0') == '1' %} checked{% endif %}> {{ t('FIELD_FILTERABLE') }}</label>
                <p class="lst-help">{{ t('HELP_FILTERABLE') }}</p>
            </span>
        </div>
    </div>
    <div class="lst-row" data-lst-for="{{ storing }}">
        <label for="lst_visibility">{{ t('FIELD_VISIBILITY') }}</label>
        <div>
            <select id="lst_visibility" name="visibility">
                {% for vis in visibilities %}<option value="{{ vis }}"{% if form.visibility == vis %} selected{% endif %}>{{ t('VISIBILITY_' ~ vis|upper) }}</option>{% endfor %}
            </select>
        </div>
    </div>

    <div class="lst-buttons">
        <button type="submit">{{ L_('TEXT:SAVE') }}</button>
        <a href="{{ url({lst_view: 'fields'}) }}">{{ L_('TEXT:CANCEL') }}</a>
    </div>
</form>
{% endblock %}
