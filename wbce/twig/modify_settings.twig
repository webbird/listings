{#
    listings/twig/modify_settings.twig – list settings and entries by visitors
#}
{% extends 'modify.twig' %}
{% block content %}
<form method="post" action="{{ action }}" class="lst-form">
    {% include '_hidden.twig' %}
    <input type="hidden" name="lst_action" value="settings_save">

    <fieldset>
        <legend>{{ t('SETTINGS_LIST') }}</legend>
        <div class="lst-row">
            <label for="lst_per_page">{{ t('PER_PAGE') }}</label>
            <div><input type="number" id="lst_per_page" name="per_page" min="1" max="{{ per_page_max }}" required value="{{ form.per_page|default('20') }}"></div>
        </div>
        <div class="lst-row">
            <label for="lst_sort">{{ t('SORT') }}</label>
            <div>
                <select id="lst_sort" name="sort">
                    {% for sort in sorts %}<option value="{{ sort }}"{% if form.sort|default('') == sort %} selected{% endif %}>{{ t('SORT_' ~ sort|upper) }}</option>{% endfor %}
                </select>
            </div>
        </div>
        <div class="lst-row">
            <span class="lst-label">{{ t('FILTER') }}</span>
            <div>
                <label><input type="checkbox" name="filter_form" value="1"{% if form.filter_form|default('0') == '1' %} checked{% endif %}> {{ t('FILTER_FORM_ON') }}</label>
                <p class="lst-help">{{ t('HELP_FILTER_FORM') }}</p>
            </div>
        </div>
        <div class="lst-row">
            <label for="lst_tags_mode">{{ t('TAGS') }}</label>
            <div>
                <select id="lst_tags_mode" name="tags_mode">
                    {% for mode in tag_modes %}<option value="{{ mode }}"{% if form.tags_mode|default('off') == mode %} selected{% endif %}>{{ t('TAGS_MODE_' ~ mode|upper) }}</option>{% endfor %}
                </select>
            </div>
        </div>
        <div class="lst-row">
            <span class="lst-label">RSS</span>
            <div>
                <label><input type="checkbox" name="rss" value="1"{% if form.rss|default('0') == '1' %} checked{% endif %}> {{ t('RSS_ON') }}</label>
                <p class="lst-help">{{ t('HELP_RSS') }} <code>{{ rss_url }}</code></p>
            </div>
        </div>
    </fieldset>

    <fieldset>
        <legend>{{ t('SETTINGS_FRONTEND') }}</legend>
        <div class="lst-row">
            <span class="lst-label">{{ t('FRONTEND') }}</span>
            <div>
                <label><input type="checkbox" name="frontend" value="1"{% if form.frontend|default('0') == '1' %} checked{% endif %}> {{ t('FRONTEND_ON') }}</label>
                <p class="lst-help">{{ t('HELP_FRONTEND') }}</p>
            </div>
        </div>
        <div class="lst-row">
            <label for="lst_owner_mode">{{ t('OWNER_MODE') }}</label>
            <div>
                <select id="lst_owner_mode" name="owner_mode" aria-describedby="lst_owner_mode_help">
                    {% for mode in owner_modes %}<option value="{{ mode }}"{% if form.owner_mode|default('email') == mode %} selected{% endif %}>{{ t('OWNER_MODE_' ~ mode|upper) }}</option>{% endfor %}
                </select>
                <p class="lst-help" id="lst_owner_mode_help">{{ t('HELP_OWNER_MODE') }}</p>
                {% if not login_available %}<p class="lst-message lst-error">{{ t('WARN_NO_LOGIN') }}</p>{% endif %}
            </div>
        </div>
        <div class="lst-row">
            <span class="lst-label">{{ t('APPROVAL') }}</span>
            <div>
                <label><input type="checkbox" name="approval" value="1"{% if form.approval|default('0') == '1' %} checked{% endif %}> {{ t('APPROVAL_ON') }}</label><br>
                <label><input type="checkbox" name="recheck" value="1"{% if form.recheck|default('0') == '1' %} checked{% endif %}> {{ t('RECHECK_ON') }}</label>
            </div>
        </div>
        <div class="lst-row">
            <label for="lst_notify">{{ t('NOTIFY_EMAIL') }}</label>
            <div>
                <input type="email" id="lst_notify" name="notify_email" maxlength="255" value="{{ form.notify_email|default('') }}">
                <p class="lst-help">{{ t('HELP_NOTIFY_EMAIL') }}</p>
            </div>
        </div>
        <div class="lst-row">
            <span class="lst-label">{{ t('SPAM') }}</span>
            <div>
                <label><input type="checkbox" name="captcha" value="1"{% if form.captcha|default('0') == '1' %} checked{% endif %}{% if not captcha_available %} disabled{% endif %}> {{ t('CAPTCHA_ON') }}</label>
                <p class="lst-help">{{ t(captcha_available ? 'HELP_CAPTCHA' : 'HELP_NO_CAPTCHA') }}</p>
            </div>
        </div>
    </fieldset>

    <fieldset>
        <legend>{{ t('SETTINGS_RUNTIME') }}</legend>
        <div class="lst-row">
            <label for="lst_runtime">{{ t('RUNTIME_DAYS') }}</label>
            <div>
                <input type="number" id="lst_runtime" name="runtime_days" min="0" max="{{ runtime_max }}" value="{{ form.runtime_days|default('0') }}" aria-describedby="lst_runtime_help">
                <p class="lst-help" id="lst_runtime_help">{{ t('HELP_RUNTIME') }}</p>
            </div>
        </div>
        <div class="lst-row">
            <label for="lst_remind">{{ t('REMIND_DAYS') }}</label>
            <div>
                <input type="number" id="lst_remind" name="remind_days" min="0" max="365" value="{{ form.remind_days|default('7') }}" aria-describedby="lst_remind_help">
                <p class="lst-help" id="lst_remind_help">{{ t('HELP_REMIND') }}</p>
            </div>
        </div>
        <div class="lst-row">
            <label for="lst_max_per_owner">{{ t('MAX_PER_OWNER') }}</label>
            <div>
                <input type="number" id="lst_max_per_owner" name="max_per_owner" min="0" max="{{ max_per_owner_limit }}" value="{{ form.max_per_owner|default('0') }}" aria-describedby="lst_max_per_owner_help">
                <p class="lst-help" id="lst_max_per_owner_help">{{ t('HELP_MAX_PER_OWNER') }}</p>
            </div>
        </div>
    </fieldset>

    <fieldset>
        <legend>{{ t('SETTINGS_CONTACT') }}</legend>
        <div class="lst-row">
            <span class="lst-label">{{ t('CONTACT') }}</span>
            <div>
                <label><input type="checkbox" name="contact" value="1"{% if form.contact|default('0') == '1' %} checked{% endif %}> {{ t('CONTACT_ON') }}</label>
                <p class="lst-help">{{ t('HELP_CONTACT') }}</p>
            </div>
        </div>
    </fieldset>

    <div class="lst-buttons">
        <button type="submit">{{ L_('TEXT:SAVE') }}</button>
    </div>
</form>
{% if import_available %}
<fieldset>
    <legend>{{ t('IMPORT_TITLE') }}</legend>
    <p>{{ t('IMPORT_TEASER') }}</p>
    <p><a class="lst-button" href="{{ url({lst_view: 'import'}) }}">{{ t('IMPORT_OPEN') }}</a></p>
</fieldset>
{% endif %}
{% endblock %}
