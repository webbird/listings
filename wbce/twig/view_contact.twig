{#
    listings/twig/view_contact.twig – contact form to the owner on the detail page.
    The owner's address is never shown; the mail goes out with Reply-To of the visitor.
#}
<h3>{{ t('CONTACT_TITLE') }}</h3>
<form method="post" action="{{ action }}" class="lst-owner-form lst-contact-form">
    <input type="hidden" name="section_id" value="{{ section_id }}">
    {{ FTAN|raw }}
    <input type="hidden" name="lst_action" value="contact">
    <input type="hidden" name="lst_item" value="{{ item_key }}">
    <div class="lst-row">
        <label for="lst_cname_{{ section_id }}">{{ t('CONTACT_NAME') }} *</label>
        <input type="text" id="lst_cname_{{ section_id }}" name="contact_name" maxlength="100" required autocomplete="name" value="{{ values.name|default('') }}">
    </div>
    <div class="lst-row">
        <label for="lst_cemail_{{ section_id }}">{{ t('CONTACT_EMAIL') }} *</label>
        <input type="email" id="lst_cemail_{{ section_id }}" name="contact_email" maxlength="255" required autocomplete="email" value="{{ values.email|default('') }}">
    </div>
    <div class="lst-row">
        <label for="lst_cmsg_{{ section_id }}">{{ t('CONTACT_MESSAGE') }} *</label>
        <textarea id="lst_cmsg_{{ section_id }}" name="contact_message" rows="6" minlength="10" maxlength="5000" required>{{ values.message|default('') }}</textarea>
    </div>
    <div class="lst-hp" aria-hidden="true">
        <label for="lst_chp_{{ section_id }}">Website</label>
        <input type="text" id="lst_chp_{{ section_id }}" name="lst_hp" value="" tabindex="-1" autocomplete="off">
    </div>
    <div class="lst-row lst-privacy">
        <label><input type="checkbox" name="privacy" value="1" required{% if values.privacy|default('') == '1' %} checked{% endif %}> {{ t('CONTACT_CONSENT') }}</label>
    </div>
    {% if captcha %}<div class="lst-captcha">{{ captcha|raw }}</div>{% endif %}
    <div class="lst-buttons">
        <button type="submit">{{ t('CONTACT_SEND') }}</button>
    </div>
</form>
